{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ПРОТОКОЛ: НЕЧТО — profession quotas",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "quotas"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "quotas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["professionId", "count"],
        "properties": {
          "professionId": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
